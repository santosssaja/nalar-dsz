# ==============================================================================
# Nalar Environment Variables Configuration
# ==============================================================================
# Salin file ini menjadi `.env` atau `.env.local` untuk konfigurasi lokal:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Nilai: 'development' | 'production' | 'test'
NODE_ENV=development

# URL dasar aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Opsional pada development: Jika dikosongkan, Nalar secara otomatis menggunakan
# engine PGlite in-memory (tanpa perlu install atau menjalankan service PostgreSQL).
#
# Untuk production atau database PostgreSQL lokal/cloud (Neon, Supabase, Railway):
# Contoh: postgresql://user:password@localhost:5432/nalar?sslmode=prefer
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nalar

# ------------------------------------------------------------------------------
# 3. Security & Session Secret
# ------------------------------------------------------------------------------
# Kunci rahasia untuk penandatanganan cookie sesi dan kunci perangkat tamu.
# Minimal 16 karakter. Ganti dengan string acak yang aman di production.
COOKIE_SECRET=nalar_dev_super_secret_cookie_key_12345

# ------------------------------------------------------------------------------
# 4. Asisten AI & Evaluator Nai (LLM Configuration)
# ------------------------------------------------------------------------------
# Provider default yang digunakan oleh backend Nalar:
# Nilai yang didukung: 'gemma' (default) | 'google' | 'openai' | 'anthropic' | 'curated'
#
# Catatan Arsitektur Nalar:
# Jika API key tidak diisi atau terjadi kegagalan koneksi internet/kuota habis,
# sistem SECARA OTOMATIS melakukan graceful fallback ke 'curated' (100% offline).
AI_DEFAULT_PROVIDER=gemma

# --- Opsi A: Google Gemma (Default Platform Nalar) ---
# Bisa menggunakan Google AI Studio API key (gratis di https://aistudio.google.com/):
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# --- Opsi B: Local LLM via Ollama / vLLM / LM Studio (100% Offline & Gratis) ---
# Jika Anda menjalankan Ollama di komputer lokal (e.g. `ollama run gemma2:9b`):
# GEMMA_ENDPOINT=http://localhost:11434
# GEMMA_MODEL=gemma2:9b

# --- Opsi C: Google Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- Opsi D: OpenAI / OpenAI-Compatible (Groq, OpenRouter, LM Studio) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Opsi E: Anthropic Claude ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# 5. Email & SMTP (Google Gmail Magic Link Email Verification)
# ------------------------------------------------------------------------------
# Digunakan untuk pengiriman tautan masuk sekali klik (magic link) via Gmail.
# Cara mendapatkan Google App Password:
#   1. Buka Akun Google > Keamanan > 2-Step Verification (pastikan aktif).
#   2. Masuk ke 'App Passwords' (https://myaccount.google.com/apppasswords).
#   3. Buat password aplikasi untuk 'Nalar', lalu salin 16 karakter password tersebut.
#
# Catatan: Jika SMTP_USER / SMTP_PASS dikosongkan pada mode dev/test,
# sistem otomatis menyediakan fallback dev link yang dapat diklik langsung di layar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nalar <no-reply@nalar.id>"
